# =============================================================================
# PakoDJ - example environment file
# Copy to bot/.env and fill in the values. Do NOT commit the real bot/.env.
# =============================================================================

# --- Discord bot (REQUIRED) --------------------------------------------------
# Token of the bot application (discord.com/developers)
token=YOUR_BOT_TOKEN

# --- PostgreSQL (required when NOT using Docker Compose) --------------------
# With Docker Compose this is injected automatically by compose;
# this value matters only for a manual run (pip install + python bot/main.py).
DATABASE_URL=postgres://pakodj:pakodj@localhost:5432/pakodj

# --- Spotify (OPTIONAL, enables Spotify URL support) -------------------------
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET

# --- Web API: Discord OAuth login (OPTIONAL, the only login method) ----------
# Create an application on discord.com/developers (OAuth2 tab), then:
#   1. DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET from that page
#   2. add the redirect URI  https://<API_PUBLIC_ORIGIN>/api/auth/discord/callback
#      with <API_PUBLIC_ORIGIN> exactly matching the value below
# Until all three values below are set, the auth endpoints answer 503
# and every other endpoint answers 401.
DISCORD_CLIENT_ID=YOUR_DISCORD_APP_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_APP_CLIENT_SECRET
API_PUBLIC_ORIGIN=https://dj.pako.uk

# Discord IDs that receive the admin flag (comma separated).
# Playback-control API endpoints (play/skip/pause/resume/stop) are admin-only;
# the flag is refreshed at every login, so changing this list takes effect at
# the next login. Find an ID with Discord: enable Developer Mode, right click
# on the user, "Copy User ID".
DISCORD_ADMIN_IDS=123456789012345678

# --- Web API: extra knobs (all OPTIONAL) -------------------------------------
# Browser origins allowed to call the API cross-origin (comma separated).
# Needed only when a browser frontend runs on another origin; server-to-server
# callers and same-origin pages don't need it.
#API_CORS_ORIGINS=https://your-webapp.example
# Session lifetime in days (default 7)
#API_SESSION_TTL_DAYS=7
# Listening address/port and uvicorn log level (defaults are fine with Compose);
# reachability is decided by the compose file - NO ports are published by default.
#API_HOST=0.0.0.0
#API_PORT=8000
#API_LOG_LEVEL=warning

# --- Cloudflare Tunnel (OPTIONAL, only with: docker compose --profile tunnel up -d)
TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN
